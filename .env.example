# Optional fallback. Prefer entering the short-lived token in the local UI.
# This server does not read .env files. Do not paste a real token into this file.
# Set RING_ACCESS_TOKEN in the process environment only if needed.
RING_ACCESS_TOKEN=

# No API key, client secret, paid model, AWS account, or database is required
# for the local Playground prototype. Generate a fresh token in the official
# Ring Developer Playground. Tokens and live sessions expire.
